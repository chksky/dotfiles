// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "outline_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "high"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "opus",
        "mode": "auto",
      },
      "type": "registry",
    },
  },
  "buffer_font_family": ".ZedMono",
  "icon_theme": "Zed (Default)",
  "edit_predictions": {
    "provider": "zed",
    "disabled_globs": [
      "**/*.json"
    ],
    // When to show edit predictions previews in buffer.
    // This setting takes two possible values:
    // 1. Display predictions inline when there are no language server completions available.
    //     "mode": "eager"
    // 2. Display predictions inline only when holding a modifier key (alt by default).
    //     "mode": "subtle"
    "mode": "subtle",
  },
  "agent": {
    "show_turn_stats": true,
    "use_modifier_to_send": true,
    "play_sound_when_agent_done": "when_hidden",
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
    },
  },
  "autosave": "on_focus_change",
  "vim_mode": true,
  "which_key": {
    "enabled": true,
    "delay_ms": 100,
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "buffer_line_height": {
    "custom": 1.45,
  },
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "colorize_brackets": true,
  "minimap": {
    "show": "auto",
    "current_line_highlight": "all"
  },
  "git": {
    "blame": {
      "show_avatar": true
    }
  },
  // buggy
  "hide_mouse": "never",
  // upd unused variables color
  "unnecessary_code_fade": 0.7,
  "show_whitespaces": "selection",
  "indent_guides": {
    "enabled": false,
    "active_line_width": 2,
    "coloring": "fixed",
    "background_coloring": "disabled",
  },
  "current_line_highlight": "all",
  "cursor_shape": "bar",
  "ensure_final_newline_on_save": false,
  "project_panel": {
    "default_width": 260,
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false,
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "git_status": true,
    "show_diagnostics": "all",
  },
  "format_on_save": "on",
  "formatter": "language_server",
  "tab_size": 2,
  "journal": {
    "hour_format": "hour24",
  },
  "prettier": {
    "allowed": true,
    "plugins": [],
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
  },
  "languages": {
    "YAML": {
      "formatter": "language_server",
    },
    "Svelte": {
      "prettier": {
        "allowed": false
      },
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    }
  },
}